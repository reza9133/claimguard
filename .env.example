# Only needed if you want to reuse the same account across deploy runs, or
# if you're deploying to a real testnet (Asimov/Bradbury) instead of
# Studionet. Never commit a real .env file.

# Used by deploy/deployStudionet.mjs (optional -- a fresh account is
# generated automatically if this is unset).
PRIVATE_KEY=

# Used by gltest.config.yaml for testnet_asimov / testnet_bradbury.
ACCOUNT_PRIVATE_KEY_1=
