# Address of the deployed ClaimGuard contract on Studionet.
# Already set to the live deployment; override if you deploy your own copy
# (see ../deploy/deployStudionet.mjs).
NEXT_PUBLIC_CONTRACT_ADDRESS=0x67Ca1fE518e1Fa416DE2c2936094c7349b579dba

# Optional: a WalletConnect Cloud project id (https://cloud.walletconnect.com/)
# for the RainbowKit "scan QR" mobile-wallet flow. The app works with browser
# extension wallets (e.g. MetaMask) without this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
